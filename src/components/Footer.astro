---
import { languages, type Locale } from '../i18n/ui';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="mt-20 border-t border-[#55A9A0]/25 dark:border-[#233735] bg-white dark:bg-[#0A1211] transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Col 1: Brand & Privacy -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2 text-deep-teal dark:text-mint-green">
          <div class="w-7 h-7 rounded-lg bg-deep-teal text-white flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-4 h-4 text-mint-green">
              <path d="M6 2v14a2 2 0 0 0 2 2h14" />
              <path d="M18 22V8a2 2 0 0 0-2-2H2" />
            </svg>
          </div>
          <span class="font-extrabold text-slate-900 dark:text-white tracking-tight">
            ProfilePic Resizer
          </span>
        </div>

        <p class="text-xs text-slate-600 dark:text-slate-400 max-w-md leading-relaxed">
          {t('footer.privacyNote')}
        </p>

        <div class="pt-2">
          <a
            href="https://buymeacoffee.com/kisharadilz"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-pale-yellow hover:bg-[#ffef82] text-slate-900 font-bold text-xs shadow-sm transition-all border border-[#e5d774]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-[#8B5A2B]">
              <path d="M18 8h1a4 4 0 0 1 0 8h-1" />
              <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z" />
              <line x1="6" y1="1" x2="6" y2="4" />
              <line x1="10" y1="1" x2="10" y2="4" />
              <line x1="14" y1="1" x2="14" y2="4" />
            </svg>
            <span>{t('footer.supportBtn')}</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Supported Networks -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-deep-teal dark:text-mint-green mb-3">
          Dimensions
        </h4>
        <ul class="space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
          <li>LinkedIn (400 × 400 px)</li>
          <li>Instagram (320 × 320 px)</li>
          <li>YouTube (800 × 800 px)</li>
          <li>TikTok (200 × 200 px)</li>
          <li>Twitter / X (400 × 400 px)</li>
          <li>Discord (128 × 128 px)</li>
        </ul>
      </div>

      <!-- Col 3: Languages & Open Source -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-deep-teal dark:text-mint-green mb-3">
          Languages
        </h4>
        <div class="flex flex-wrap gap-2 text-xs">
          {
            Object.entries(languages).map(([code, item]) => {
              const targetLang = code as Locale;
              const path = getLocalizedPath(Astro.url.pathname, targetLang);
              return (
                <a
                  href={path}
                  class={`px-2 py-1 rounded-lg border text-xs transition-colors ${
                    code === lang
                      ? 'bg-[#AEEED3]/30 border-deep-teal font-bold text-deep-teal dark:text-mint-green'
                      : 'border-slate-200 dark:border-[#233735] text-slate-600 dark:text-slate-400 hover:border-muted-teal'
                  }`}
                >
                  {item.flag} {item.name}
                </a>
              );
            })
          }
        </div>
      </div>

    </div>

    <!-- Bottom line -->
    <div class="mt-8 pt-6 border-t border-slate-100 dark:border-[#233735] flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-slate-500 dark:text-slate-400">
      <div>
        © 2026 ProfilePic Resizer. {t('footer.rights')}
      </div>
      <div class="flex items-center gap-4">
        <a href="https://buymeacoffee.com/kisharadilz" target="_blank" rel="noopener noreferrer" class="hover:text-deep-teal dark:hover:text-mint-green transition-colors">
          Buy Me A Coffee
        </a>
        <span>•</span>
        <span>Hosted on GitHub Pages</span>
      </div>
    </div>

  </div>
</footer>

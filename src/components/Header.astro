---
import { languages, type Locale } from '../i18n/ui';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentLangObj = languages[lang];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/90 dark:bg-[#0D1615]/90 border-b border-[#55A9A0]/20 dark:border-[#233735] transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2">
    
    <!-- Brand Logo -->
    <a 
      href={lang === 'en' ? '/' : `/${lang}/`} 
      class="flex items-center gap-2.5 text-deep-teal dark:text-mint-green group transition-transform active:scale-95"
      aria-label="ProfilePic Resizer Home"
    >
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-deep-teal to-muted-teal text-white flex items-center justify-center shadow-sm group-hover:shadow-glow transition-all">
        <!-- SVG Avatar Crop Logo -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-mint-green">
          <path d="M6 2v14a2 2 0 0 0 2 2h14" />
          <path d="M18 22V8a2 2 0 0 0-2-2H2" />
          <circle cx="12" cy="12" r="3" fill="#FFF8B0" stroke="none" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold text-base sm:text-lg tracking-tight text-slate-900 dark:text-white leading-none">
          ProfilePic <span class="text-deep-teal dark:text-mint-green">Resizer</span>
        </span>
        <span class="hidden md:inline text-[10px] font-semibold text-muted-teal dark:text-slate-400 leading-tight">
          100% Client-Side Crop
        </span>
      </div>
    </a>

    <!-- Navigation Actions (Strictly ICONS ONLY on mobile and tablet, full text labels on desktop) -->
    <div class="flex items-center gap-1.5 sm:gap-2 lg:gap-3">
      
      <!-- Language Selector Dropdown -->
      <div class="relative group" id="lang-dropdown-wrapper">
        <button
          type="button"
          id="lang-btn"
          class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-[#233735] bg-slate-50/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 hover:border-muted-teal hover:bg-white dark:hover:bg-slate-800 text-xs font-semibold transition-all focus:outline-none focus:ring-2 focus:ring-[#AEEED3]"
          aria-expanded="false"
          aria-haspopup="true"
          title={t('nav.lang')}
        >
          <!-- Globe Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-deep-teal dark:text-mint-green">
            <circle cx="12" cy="12" r="10" />
            <line x1="2" y1="12" x2="22" y2="12" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          
          <!-- Flag on mobile, Flag + Full Label on Desktop -->
          <span class="text-xs">{currentLangObj.flag}</span>
          <span class="hidden lg:inline">{currentLangObj.name}</span>
          
          <!-- Caret -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-200 transition-transform group-hover:rotate-180">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div 
          id="lang-menu"
          class="absolute right-0 mt-1.5 w-40 bg-white dark:bg-[#162322] border border-slate-200 dark:border-[#233735] rounded-xl shadow-lg py-1.5 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-150 z-50"
        >
          {
            Object.entries(languages).map(([code, item]) => {
              const targetLang = code as Locale;
              const path = getLocalizedPath(Astro.url.pathname, targetLang);
              const isActive = code === lang;
              return (
                <a
                  href={path}
                  class={`flex items-center justify-between px-3 py-1.5 text-xs font-medium transition-colors ${
                    isActive
                      ? 'bg-[#AEEED3]/30 text-deep-teal dark:text-mint-green font-bold'
                      : 'text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800'
                  }`}
                >
                  <span class="flex items-center gap-2">
                    <span>{item.flag}</span>
                    <span>{item.name}</span>
                  </span>
                  {isActive && (
                    <span class="w-1.5 h-1.5 rounded-full bg-deep-teal dark:bg-mint-green" />
                  )}
                </a>
              );
            })
          }
        </div>
      </div>

      <!-- Light / Dark Theme Switcher Button -->
      <button
        type="button"
        id="theme-toggle"
        class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-[#233735] bg-slate-50/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 hover:border-muted-teal hover:bg-white dark:hover:bg-slate-800 text-xs font-semibold transition-all focus:outline-none focus:ring-2 focus:ring-[#AEEED3]"
        title={t('nav.theme')}
        aria-label={t('nav.theme')}
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 hidden dark:block text-pale-yellow">
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>

        <!-- Moon icon (shown in light mode) -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 block dark:hidden text-deep-teal">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>

        <!-- Text label on desktop ONLY, collapsed to icon on mobile/tablet -->
        <span class="hidden lg:inline text-xs font-semibold">{t('nav.theme')}</span>
      </button>

      <!-- Support Developer CTA Button (https://buymeacoffee.com/kisharadilz) -->
      <a
        href="https://buymeacoffee.com/kisharadilz"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-xl bg-pale-yellow hover:bg-[#ffef82] text-slate-900 border border-[#e5d774] text-xs font-bold shadow-sm hover:shadow transition-all group active:scale-95"
        title="Support the Developer on Buy Me a Coffee"
        aria-label="Support the Developer on Buy Me a Coffee"
      >
        <!-- Coffee Cup Icon -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[#8B5A2B] group-hover:scale-110 transition-transform">
          <path d="M18 8h1a4 4 0 0 1 0 8h-1" />
          <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z" />
          <line x1="6" y1="1" x2="6" y2="4" />
          <line x1="10" y1="1" x2="10" y2="4" />
          <line x1="14" y1="1" x2="14" y2="4" />
        </svg>

        <!-- Text label strictly hidden on Mobile & Tablet, visible on Desktop -->
        <span class="hidden lg:inline text-xs font-bold text-slate-900">
          {t('nav.support')}
        </span>
      </a>

    </div>
  </div>
</header>

<script is:inline>
  // Theme toggle functionality
  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }
</script>
